# Minimal reference journal using the implemented Fiscus version 1 syntax.

meta version 1
meta journal "personal"

account asset:bank:example-bank:au:everyday
account equity:opening-balances
account income:employment:example-employer:salary
account expense:food:groceries

transaction 2026-01-01 "Opening balance" {
    debit  asset:bank:example-bank:au:everyday 1000.00 AUD
    credit equity:opening-balances              1000.00 AUD
}

transaction 2026-01-15 "January salary" {
    debit  asset:bank:example-bank:au:everyday       3000.00 AUD
    credit income:employment:example-employer:salary 3000.00 AUD
}

transaction 2026-01-17 "Groceries" {
    debit  expense:food:groceries                    82.40 AUD
    credit asset:bank:example-bank:au:everyday       82.40 AUD
}
